# ─────────────────────────────────────────────────────────
#  AI 제공자 설정 (선택)
# ─────────────────────────────────────────────────────────
# key 없이도 mock 응답으로 전체 앱을 테스트할 수 있습니다.
# 실제 LLM을 붙이려면 아래 값을 채운 뒤 파일명을 .env.local 로 바꾸세요.

# mock | openai   (기본값: mock)
AI_PROVIDER=mock

# OpenAI 사용 시
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI 호환 엔드포인트(예: 프록시/타 LLM)를 쓰려면 변경
OPENAI_BASE_URL=https://api.openai.com/v1
